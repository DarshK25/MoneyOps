# Backend API URL — points to API Gateway (port 8002) which routes:
#   /api/**       -> Backend Core (:8000)
#   /api/v1/**    -> AI Gateway (:8005)
VITE_API_URL=http://localhost:8002

# AI Gateway direct URL (used for real-time voice endpoints)
VITE_AI_GATEWAY_URL=http://localhost:8005

# Voice Service URL
VITE_VOICE_SERVICE_URL=http://localhost:8003

# Better Auth is handled server-side via Spring Security OAuth2
# No frontend auth keys needed
